# Copie para .env.local e preencha. NUNCA faça commit de .env.local.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # ou a "anon key" legada
SUPABASE_SECRET_KEY=sb_secret_xxx                         # SOMENTE servidor (exclusão de conta). Ou SUPABASE_SERVICE_ROLE_KEY.

# URL pública do app (usada nos links de e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contato exibido no site
NEXT_PUBLIC_SUPPORT_EMAIL=suporte@seudominio.com.br
NEXT_PUBLIC_COMPANY_NAME=Controle Fácil

# Assistente Controle Fácil IA (Anthropic / Claude). SOMENTE servidor.
# Sem a chave, o assistente aparece como "indisponível" e nenhuma análise é descontada.
ANTHROPIC_API_KEY=
# Modelo (padrão: claude-opus-5-5). Ex.: claude-sonnet-5-5 ou claude-haiku-5-5 para reduzir custo.
AI_MODEL=claude-opus-5-5

# Assinaturas — Mercado Pago (SOMENTE servidor). Use primeiro as credenciais DE TESTE (TEST-...).
MERCADOPAGO_ACCESS_TOKEN=
# "Assinatura secreta" da configuração de Webhooks da aplicação no Mercado Pago.
MERCADOPAGO_WEBHOOK_SECRET=
# Só habilite depois de validar o fluxo completo no ambiente de testes do Mercado Pago.
BILLING_ENABLED=false

# E-mails de cobrança (recibo, pagamento recusado, cancelamento) via SMTP — SOMENTE servidor.
# Funciona com qualquer provedor (Resend, Amazon SES, Brevo, SendGrid...). Sem SMTP_HOST/EMAIL_FROM
# os e-mails ficam na fila e nada é enviado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Controle Fácil <cobranca@seudominio.com.br>"
# Protege /api/cron/emails (reenvio de e-mails que falharam). Gere um valor aleatório longo.
CRON_SECRET=
